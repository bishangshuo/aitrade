<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aitrade.risk.mapper.TfRiskReportAnnMapper">
    
    <resultMap type="TfRiskReportAnn" id="TfRiskReportAnnResult">
        <result property="id"    column="id"    />
        <result property="riskReportId"    column="risk_report_id"    />
        <result property="riskAnnId"    column="risk_ann_id"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectTfRiskReportAnnVo">
        select id, risk_report_id, risk_ann_id, create_time from tf_risk_report_ann
    </sql>

    <select id="selectTfRiskReportAnnList" parameterType="TfRiskReportAnn" resultMap="TfRiskReportAnnResult">
        <include refid="selectTfRiskReportAnnVo"/>
        <where>  
            <if test="riskReportId != null "> and risk_report_id = #{riskReportId}</if>
            <if test="riskAnnId != null "> and risk_ann_id = #{riskAnnId}</if>
        </where>
    </select>
    
    <select id="selectTfRiskReportAnnById" parameterType="Long" resultMap="TfRiskReportAnnResult">
        <include refid="selectTfRiskReportAnnVo"/>
        where id = #{id}
    </select>

    <insert id="insertTfRiskReportAnn" parameterType="TfRiskReportAnn" useGeneratedKeys="true" keyProperty="id">
        insert into tf_risk_report_ann
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="riskReportId != null">risk_report_id,</if>
            <if test="riskAnnId != null">risk_ann_id,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="riskReportId != null">#{riskReportId},</if>
            <if test="riskAnnId != null">#{riskAnnId},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateTfRiskReportAnn" parameterType="TfRiskReportAnn">
        update tf_risk_report_ann
        <trim prefix="SET" suffixOverrides=",">
            <if test="riskReportId != null">risk_report_id = #{riskReportId},</if>
            <if test="riskAnnId != null">risk_ann_id = #{riskAnnId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteTfRiskReportAnnById" parameterType="Long">
        delete from tf_risk_report_ann where id = #{id}
    </delete>

    <delete id="deleteTfRiskReportAnnByIds" parameterType="String">
        delete from tf_risk_report_ann where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>