<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aitrade.risk.mapper.TfRiskReportMapper">
    
    <resultMap type="TfRiskReport" id="TfRiskReportResult">
        <result property="id"    column="id"    />
        <result property="stockCode"    column="stock_code"    />
        <result property="stockName"    column="stock_name"    />
        <result property="marketType"    column="market_type"    />
        <result property="riskAnnId"    column="risk_ann_id"    />
        <result property="inputParams"    column="input_params"    />
        <result property="outputResponse"    column="output_response"    />
        <result property="passed"    column="passed"    />
        <result property="remarks"    column="remarks"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectTfRiskReportVo">
        select id, stock_code, stock_name, market_type, risk_ann_id, input_params, output_response, passed, remarks, create_time from tf_risk_report
    </sql>

    <select id="selectTfRiskReportList" parameterType="TfRiskReport" resultMap="TfRiskReportResult">
        <include refid="selectTfRiskReportVo"/>
        <where>  
            <if test="stockCode != null  and stockCode != ''"> and stock_code = #{stockCode}</if>
            <if test="stockName != null  and stockName != ''"> and stock_name like concat('%', #{stockName}, '%')</if>
            <if test="marketType != null "> and market_type = #{marketType}</if>
            <if test="riskAnnId != null "> and risk_ann_id = #{riskAnnId}</if>
            <if test="inputParams != null  and inputParams != ''"> and input_params = #{inputParams}</if>
            <if test="outputResponse != null  and outputResponse != ''"> and output_response = #{outputResponse}</if>
            <if test="passed != null "> and passed = #{passed}</if>
            <if test="remarks != null  and remarks != ''"> and remarks = #{remarks}</if>
        </where>
    </select>
    
    <select id="selectTfRiskReportById" parameterType="Long" resultMap="TfRiskReportResult">
        <include refid="selectTfRiskReportVo"/>
        where id = #{id}
    </select>

    <insert id="insertTfRiskReport" parameterType="TfRiskReport" useGeneratedKeys="true" keyProperty="id">
        insert into tf_risk_report
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="stockCode != null and stockCode != ''">stock_code,</if>
            <if test="stockName != null and stockName != ''">stock_name,</if>
            <if test="marketType != null">market_type,</if>
            <if test="riskAnnId != null">risk_ann_id,</if>
            <if test="inputParams != null">input_params,</if>
            <if test="outputResponse != null">output_response,</if>
            <if test="passed != null">passed,</if>
            <if test="remarks != null">remarks,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="stockCode != null and stockCode != ''">#{stockCode},</if>
            <if test="stockName != null and stockName != ''">#{stockName},</if>
            <if test="marketType != null">#{marketType},</if>
            <if test="riskAnnId != null">#{riskAnnId},</if>
            <if test="inputParams != null">#{inputParams},</if>
            <if test="outputResponse != null">#{outputResponse},</if>
            <if test="passed != null">#{passed},</if>
            <if test="remarks != null">#{remarks},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateTfRiskReport" parameterType="TfRiskReport">
        update tf_risk_report
        <trim prefix="SET" suffixOverrides=",">
            <if test="stockCode != null and stockCode != ''">stock_code = #{stockCode},</if>
            <if test="stockName != null and stockName != ''">stock_name = #{stockName},</if>
            <if test="marketType != null">market_type = #{marketType},</if>
            <if test="riskAnnId != null">risk_ann_id = #{riskAnnId},</if>
            <if test="inputParams != null">input_params = #{inputParams},</if>
            <if test="outputResponse != null">output_response = #{outputResponse},</if>
            <if test="passed != null">passed = #{passed},</if>
            <if test="remarks != null">remarks = #{remarks},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteTfRiskReportById" parameterType="Long">
        delete from tf_risk_report where id = #{id}
    </delete>

    <delete id="deleteTfRiskReportByIds" parameterType="String">
        delete from tf_risk_report where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>