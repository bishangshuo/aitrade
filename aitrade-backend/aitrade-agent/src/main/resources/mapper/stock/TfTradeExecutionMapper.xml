<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aitrade.stock.mapper.TfTradeExecutionMapper">
    
    <resultMap type="TfTradeExecution" id="TfTradeExecutionResult">
        <result property="id"    column="id"    />
        <result property="accountNo"    column="account_no"    />
        <result property="orderId"    column="order_id"    />
        <result property="symbol"    column="symbol"    />
        <result property="stockName"    column="stock_name"    />
        <result property="tradeSide"    column="trade_side"    />
        <result property="tradePrice"    column="trade_price"    />
        <result property="tradeVolume"    column="trade_volume"    />
        <result property="tradeAmount"    column="trade_amount"    />
        <result property="commission"    column="commission"    />
        <result property="tax"    column="tax"    />
        <result property="realizedPnl"    column="realized_pnl"    />
        <result property="tradeTime"    column="trade_time"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectTfTradeExecutionVo">
        select id, account_no, order_id, symbol, stock_name, trade_side, trade_price, trade_volume, trade_amount, commission, tax, realized_pnl, trade_time, create_time from tf_trade_execution
    </sql>

    <select id="selectTfTradeExecutionList" parameterType="TfTradeExecution" resultMap="TfTradeExecutionResult">
        <include refid="selectTfTradeExecutionVo"/>
        <where>  
            <if test="accountNo != null  and accountNo != ''"> and account_no = #{accountNo}</if>
            <if test="orderId != null  and orderId != ''"> and order_id = #{orderId}</if>
            <if test="symbol != null  and symbol != ''"> and symbol = #{symbol}</if>
            <if test="stockName != null  and stockName != ''"> and stock_name like concat('%', #{stockName}, '%')</if>
            <if test="tradeSide != null  and tradeSide != ''"> and trade_side = #{tradeSide}</if>
            <if test="tradePrice != null "> and trade_price = #{tradePrice}</if>
            <if test="tradeVolume != null "> and trade_volume = #{tradeVolume}</if>
            <if test="tradeAmount != null "> and trade_amount = #{tradeAmount}</if>
            <if test="commission != null "> and commission = #{commission}</if>
            <if test="tax != null "> and tax = #{tax}</if>
            <if test="realizedPnl != null "> and realized_pnl = #{realizedPnl}</if>
            <if test="tradeTime != null "> and trade_time = #{tradeTime}</if>
        </where>
    </select>
    
    <select id="selectTfTradeExecutionById" parameterType="Long" resultMap="TfTradeExecutionResult">
        <include refid="selectTfTradeExecutionVo"/>
        where id = #{id}
    </select>

    <insert id="insertTfTradeExecution" parameterType="TfTradeExecution" useGeneratedKeys="true" keyProperty="id">
        insert into tf_trade_execution
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="accountNo != null and accountNo != ''">account_no,</if>
            <if test="orderId != null and orderId != ''">order_id,</if>
            <if test="symbol != null and symbol != ''">symbol,</if>
            <if test="stockName != null and stockName != ''">stock_name,</if>
            <if test="tradeSide != null and tradeSide != ''">trade_side,</if>
            <if test="tradePrice != null">trade_price,</if>
            <if test="tradeVolume != null">trade_volume,</if>
            <if test="tradeAmount != null">trade_amount,</if>
            <if test="commission != null">commission,</if>
            <if test="tax != null">tax,</if>
            <if test="realizedPnl != null">realized_pnl,</if>
            <if test="tradeTime != null">trade_time,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="accountNo != null and accountNo != ''">#{accountNo},</if>
            <if test="orderId != null and orderId != ''">#{orderId},</if>
            <if test="symbol != null and symbol != ''">#{symbol},</if>
            <if test="stockName != null and stockName != ''">#{stockName},</if>
            <if test="tradeSide != null and tradeSide != ''">#{tradeSide},</if>
            <if test="tradePrice != null">#{tradePrice},</if>
            <if test="tradeVolume != null">#{tradeVolume},</if>
            <if test="tradeAmount != null">#{tradeAmount},</if>
            <if test="commission != null">#{commission},</if>
            <if test="tax != null">#{tax},</if>
            <if test="realizedPnl != null">#{realizedPnl},</if>
            <if test="tradeTime != null">#{tradeTime},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateTfTradeExecution" parameterType="TfTradeExecution">
        update tf_trade_execution
        <trim prefix="SET" suffixOverrides=",">
            <if test="accountNo != null and accountNo != ''">account_no = #{accountNo},</if>
            <if test="orderId != null and orderId != ''">order_id = #{orderId},</if>
            <if test="symbol != null and symbol != ''">symbol = #{symbol},</if>
            <if test="stockName != null and stockName != ''">stock_name = #{stockName},</if>
            <if test="tradeSide != null and tradeSide != ''">trade_side = #{tradeSide},</if>
            <if test="tradePrice != null">trade_price = #{tradePrice},</if>
            <if test="tradeVolume != null">trade_volume = #{tradeVolume},</if>
            <if test="tradeAmount != null">trade_amount = #{tradeAmount},</if>
            <if test="commission != null">commission = #{commission},</if>
            <if test="tax != null">tax = #{tax},</if>
            <if test="realizedPnl != null">realized_pnl = #{realizedPnl},</if>
            <if test="tradeTime != null">trade_time = #{tradeTime},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteTfTradeExecutionById" parameterType="Long">
        delete from tf_trade_execution where id = #{id}
    </delete>

    <delete id="deleteTfTradeExecutionByIds" parameterType="String">
        delete from tf_trade_execution where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>