<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aitrade.stock.mapper.TfConfigStrategyTradeMapper">
    
    <resultMap type="TfConfigStrategyTrade" id="TfConfigStrategyTradeResult">
        <result property="id"    column="id"    />
        <result property="configName"    column="config_name"    />
        <result property="t1HighOpenRatio"    column="t1_high_open_ratio"    />
        <result property="holdDays"    column="hold_days"    />
        <result property="stopLossMethod" column="stop_loss_method"    />
        <result property="stopLossRatio"    column="stop_loss_ratio"    />
        <result property="stopProfitMethod"    column="stop_profit_method"    />
        <result property="stopProfitRatio"    column="stop_profit_ratio"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectTfConfigStrategyTradeVo">
        select id, config_name, t1_high_open_ratio, hold_days, stop_loss_method, stop_loss_ratio, stop_profit_method, stop_profit_ratio, create_time, update_time from tf_config_strategy_trade
    </sql>

    <select id="selectTfConfigStrategyTradeList" parameterType="TfConfigStrategyTrade" resultMap="TfConfigStrategyTradeResult">
        <include refid="selectTfConfigStrategyTradeVo"/>
        <where>
            <if test="configName != null "> and config_name = #{configName}</if>
            <if test="t1HighOpenRatio != null "> and t1_high_open_ratio = #{t1HighOpenRatio}</if>
            <if test="holdDays != null "> and hold_days = #{holdDays}</if>
            <if test="stopLossMethod != null "> and stop_loss_method = #{stopLossMethod}</if>
            <if test="stopLossRatio != null "> and stop_loss_ratio = #{stopLossRatio}</if>
            <if test="stopProfitMethod != null "> and stop_profit_method = #{stopProfitMethod}</if>
            <if test="stopProfitRatio != null "> and stop_profit_ratio = #{stopProfitRatio}</if>
        </where>
    </select>
    
    <select id="selectTfConfigStrategyTradeById" parameterType="Long" resultMap="TfConfigStrategyTradeResult">
        <include refid="selectTfConfigStrategyTradeVo"/>
        where id = #{id}
    </select>

    <insert id="insertTfConfigStrategyTrade" parameterType="TfConfigStrategyTrade" useGeneratedKeys="true" keyProperty="id">
        insert into tf_config_strategy_trade
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="configName != null">config_name,</if>
            <if test="t1HighOpenRatio != null">t1_high_open_ratio,</if>
            <if test="holdDays != null">hold_days,</if>
            <if test="stopLossMethod != null">stop_loss_method,</if>
            <if test="stopLossRatio != null">stop_loss_ratio,</if>
            <if test="stopProfitMethod != null">stop_profit_method,</if>
            <if test="stopProfitRatio != null">stop_profit_ratio,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="configName != null">#{configName},</if>
            <if test="t1HighOpenRatio != null">#{t1HighOpenRatio},</if>
            <if test="holdDays != null">#{holdDays},</if>
            <if test="stopLossMethod != null">#{stopLossMethod},</if>
            <if test="stopLossRatio != null">#{stopLossRatio},</if>
            <if test="stopProfitMethod != null">#{stopProfitMethod},</if>
            <if test="stopProfitRatio != null">#{stopProfitRatio},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateTfConfigStrategyTrade" parameterType="TfConfigStrategyTrade">
        update tf_config_strategy_trade
        <trim prefix="SET" suffixOverrides=",">
            <if test="configName != null">config_name = #{configName},</if>
            <if test="t1HighOpenRatio != null">t1_high_open_ratio = #{t1HighOpenRatio},</if>
            <if test="holdDays != null">hold_days = #{holdDays},</if>
            <if test="stopLossMethod != null">stop_loss_method = #{stopLossMethod},</if>
            <if test="stopLossRatio != null">stop_loss_ratio = #{stopLossRatio},</if>
            <if test="stopProfitMethod != null">stop_profit_method = #{stopProfitMethod},</if>
            <if test="stopProfitRatio != null">stop_profit_ratio = #{stopProfitRatio},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteTfConfigStrategyTradeById" parameterType="Long">
        delete from tf_config_strategy_trade where id = #{id}
    </delete>

    <delete id="deleteTfConfigStrategyTradeByIds" parameterType="String">
        delete from tf_config_strategy_trade where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>