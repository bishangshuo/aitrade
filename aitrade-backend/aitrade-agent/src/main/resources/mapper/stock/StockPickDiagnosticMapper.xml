    <sql id="selectStockPickDiagnostic">
        select id, symbol, stock_name, trade_date, strategy_code, strategy_name, passed, fail_reason,
        match_vcp, match_ma_coil, match_air_refuel, close_price, change_rate,
        vol_ratio, vcp_amplitude, macd_dif, macd_dea, macd_hist,
        kdj_k, kdj_d, rsi14, obv, profit_ratio, is_chip_single_peak,
        volume_score, chip_score, momentum_score, pattern_score, total_score, created_at
    </sql>

    <insert id="insertBatch" parameterType="java.util.List" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ta_stock_pick_diagnostic (
        symbol, stock_name, trade_date, strategy_code, strategy_name, passed, fail_reason,
        match_vcp, match_ma_coil, match_air_refuel, close_price, change_rate,
        vol_ratio, vcp_amplitude, macd_dif, macd_dea, macd_hist,
        kdj_k, kdj_d, rsi14, obv, profit_ratio, is_chip_single_peak,
        volume_score, chip_score, momentum_score, pattern_score, total_score
        ) VALUES
        <foreach collection="list" item="item" separator=",">
            (
            #{item.symbol}, #{item.stockName}, #{item.tradeDate}, #{item.strategyCode}, #{item.strategyName}, #{item.passed}, #{item.failReason},
            #{item.matchVcp}, #{item.matchMaCoil}, #{item.matchAirRefuel}, #{item.closePrice}, #{item.changeRate},
            #{item.volRatio}, #{item.vcpAmplitude}, #{item.macdDif}, #{item.macdDea}, #{item.macdHist},
            #{item.kdjK}, #{item.kdjD}, #{item.rsi14}, #{item.obv}, #{item.profitRatio}, #{item.isChipSinglePeak},
            #{item.volumeScore}, #{item.chipScore}, #{item.momentumScore}, #{item.patternScore}, #{item.totalScore}
            )
        </foreach>
    </insert>
    <select id="selectTopScore" parameterType="StockPickDiagnostic" resultMap="StockPickDiagnosticResult">
        <include refid="selectStockPickDiagnostic"/>
        <where>
            <if test="et.symbol != null and et.symbol != ''"> and symbol = #{et.symbol} </if>
            <if test="et.stockName != null and et.stockName != ''"> and stock_name like CONCAT('%', #{et.stockName}, '%') </if>
            <if test="et.tradeDate != null"> and DATE(trade_date) = DATE(#{et.tradeDate}) </if>
            <if test="et.strategyCode != null"> and strategy_code = #{et.strategyCode} </if>
            <if test="et.strategyName != null and et.strategyName != ''"> and strategy_name like CONCAT('%', #{et.strategyName}, '%') </if>
            <if test="et.passed != null"> and passed = #{et.passed} </if>
        </where>
        ORDER BY total_score DESC
        LIMIT #{limit}
    </select>

</mapper>